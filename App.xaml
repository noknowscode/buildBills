<Application
    x:Class="UnoCompletionAnimations.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F8F5" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#24382D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#84968A" />
        <SolidColorBrush x:Key="SageBrush" Color="#478158" />
        <SolidColorBrush x:Key="SageSoftBrush" Color="#EAF3E9" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E7EDE5" />

        <Style TargetType="Page">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EDF1EB" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SageBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>