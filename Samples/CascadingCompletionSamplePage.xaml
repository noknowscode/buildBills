<Page
    x:Class="UnoCompletionAnimations.Samples.CascadingCompletionSamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cascade="using:UnoCompletionAnimations.Components.Completion.Cascade">
    <ScrollViewer>
        <StackPanel Padding="20,14,20,36" Spacing="14" MaxWidth="680" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Cascading Completion" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="The completed row glides through each remaining position and docks into Paid before the collection changes." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <cascade:CascadingCompletionList x:Name="CascadeList" AnimationCompleted="CascadeList_AnimationCompleted" />

            <Grid Margin="0,8,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Reset sample" Style="{StaticResource PrimaryButtonStyle}" Click="Reset_Click" />
                <TextBlock x:Name="LastCompleted" Grid.Column="1" VerticalAlignment="Center" Text="Nothing completed yet" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>